<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sdd</AssemblyName>
    <RootNamespace>Sdd</RootNamespace>
    <Version>0.1.0</Version>
    <PackageId>sdd</PackageId>
    <Description>SDD-Kit CLI — scaffold doctrine + specs (P1 : init, new)</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sdd</ToolCommandName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/DOCTRINE.md" />
    <EmbeddedResource Include="resources/SPEC-template.md" />
  </ItemGroup>

</Project>
