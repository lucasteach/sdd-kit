<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sdd</AssemblyName>
    <RootNamespace>Sdd</RootNamespace>
    <Version>1.0.8</Version>
    <PackageId>sdd</PackageId>
    <Description>SDD-Kit CLI v1 — doctrine, scaffold, arbitre, trace et contrat agent (init/new/lint/status/decide/trace/agent-brief/adopt)</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Authors>lucasteach</Authors>
    <PackageProjectUrl>https://github.com/lucasteach/sdd-kit</PackageProjectUrl>
    <RepositoryUrl>https://github.com/lucasteach/sdd-kit.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>sdd</ToolCommandName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- no PDB : evite embarquer les chemins de build locaux dans le paquet -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources/DOCTRINE.md" />
    <EmbeddedResource Include="resources/SPEC-template.md" />
    <!-- WithCulture=false : sinon MSBuild lit « .fr »/« .en » comme une culture -->
    <EmbeddedResource Include="resources/DOCTRINE.fr.md" WithCulture="false" />
    <EmbeddedResource Include="resources/DOCTRINE.en.md" WithCulture="false" />
  </ItemGroup>

</Project>
